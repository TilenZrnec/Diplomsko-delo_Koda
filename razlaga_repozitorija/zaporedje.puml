' ===========================================================================
' Diagram zaporedja: kako se datoteke v tem repozitoriju kličejo med seboj.
'
' Datoteka vsebuje štiri ločene diagrame (@startuml ... @enduml). Vsak
' predstavlja eno fazo dela; skupaj pokrivajo vse izvorne datoteke repozitorija.
'
' Izris (poljubno):
'   plantuml razlaga_repozitorija/zaporedje.puml        # -> PNG poleg .puml
'   plantuml -tsvg razlaga_repozitorija/zaporedje.puml  # -> SVG
'   ali razširitev "PlantUML" v VS Code (Alt+D za predogled)
'
' VZDRŽEVANJE: ta diagram mora našteti vsako izvorno datoteko iz src/ in
' scripts/ s polno potjo. Preveri z:
'   python3 razlaga_repozitorija/preveri_diagram.py
' Isto preverjanje teče samodejno ob 'git push' (glej razlaga_repozitorija/README.md).
' ===========================================================================


' ---------------------------------------------------------------------------
' 1. PRIPRAVA - teče lokalno, enkrat. Zamrzne seznam naborov in izmeri,
'    kako veliki so (podlaga za --time in --mem na Arnesu).
' ---------------------------------------------------------------------------
@startuml 01_priprava
title 1. Priprava (lokalno, enkrat)

skinparam sequenceMessageAlign center
autonumber

actor "Uporabnik" as U
participant "scripts/gen_cc18_ids.py" as GEN
participant "scripts/gen_tuning_ids.py" as GENT
participant "scripts/gen_leakage_ids.py" as GENL
participant "scripts/profile_datasets.py" as PROF
participant "src/config.py" as CFGPY
participant "src/data.py" as DATA
database "OpenML\n(splet)" as OML
collections "scripts/cc18_ids.json\nscripts/subset_ids.json\nscripts/medic3.json\nscripts/medic3_160.json" as IDS
collections "config.yaml" as CFG

U -> GEN : python scripts/gen_cc18_ids.py
activate GEN
GEN -> CFGPY : load_config() - cache_dir
GEN -> OML : openml.study.get_suite(99)
OML --> GEN : zbirka OpenML-CC18
GEN -> GEN : dedup + sort ID-jev
alt število ID-jev != 72
    GEN --> U : **SystemExit** - zbirka se je spremenila
else 72 ID-jev
    GEN -> IDS : zapiše cc18_ids.json
end
deactivate GEN

U -> GENT : python scripts/gen_tuning_ids.py (enkrat, 2026-10-15)
activate GENT
GENT -> GENT : nasičenost iz cc18_v4/combined (pravilo src/summary.py)
GENT -> IDS : cc18_tuning_ids.json: 68 naborov (brez 4 velikih\nslikovnih), najprej 36 nenasičenih
deactivate GENT

U -> GENL : python scripts/gen_leakage_ids.py ~--check (enkrat, 2026-10-21)
activate GENL
GENL -> CFGPY : load_config() - razdelek leakage;\ndataset_specs(cc18_tuning), dataset_specs(medic3_160)
GENL -> DATA : load_dataset(spec) - šteje številske atribute;\nz ~--check naloži vse tri različice (_perturb) in preveri\nfolde, vezi, vzorec NaN (le podatki, brez modelov)
GENL -> IDS : cc18_leakage.json (34 naborov x 3 različice),\nmedic3_160_leakage.json, leakage_smoke.json
deactivate GENL
note right of GENL
  Test uhajanja: original, monotone (kubični koren
  standardizirane vrednosti), monotone_noise (+ šum
  0,1 std). Nabora brez številskega atributa izpadeta.
  Zasnova: results/runs/cc18_leakage/DESIGN.md
end note

note over IDS, CFG
  config.yaml je **edini vir parametrov**: random_state, n_splits,
  n_repeats, algorithms, cache_dir, results_dir, save_predictions,
  saturation_threshold, alpha - in slovar dataset_sets, ki imenu
  nabora (subset, cc18, medic3) priredi JSON datoteko z opisi naborov.
  Vsi skripti ga berejo prek src/config.py (load_config, dataset_specs).

  cc18_ids.json se **commita v git**: obseg eksperimenta je zamrznjen.
  subset_ids.json = [31, 37, 38], pilotna trojica.
  medic3_160.json = isto, z "max_classes": 160 (glej diagram 3).
  medic3.json = {"source": "csv", "path": "data/medic3/Medic3.csv", ...} -
  opis lokalnega nabora, ki ga src/data.py naloži enako kot OpenML.
end note

U -> PROF : python scripts/profile_datasets.py ~--dataset-set cc18
activate PROF
PROF -> CFGPY : load_config(), dataset_specs(config, "cc18")
CFGPY -> IDS : prebere JSON seznam
CFGPY --> PROF : opisi naborov
alt privzeto (hitro, brez prenosa)
    PROF -> OML : list_datasets(data_id=ids) - samo metapodatki
    OML --> PROF : vrstice x atributi x razredi
else ~--from-cache (edina pot za CSV nabore)
    PROF -> DATA : load_dataset(spec, ...) za vsak nabor
    DATA --> PROF : dejanske oblike DataFrameov
end
PROF --> U : tabela naborov, urejena padajoče po št. celic
deactivate PROF

note right of PROF
  Namen: podatkovno podprta izbira
  SLURM parametrov ~--time in ~--mem.
  Največji nabori (CIFAR_10 60000x3072,
  Devnagari-Script 92000x1024) določajo,
  koliko virov potrebuje en array task.
end note

@enduml


' ---------------------------------------------------------------------------
' 2. LOKALNI PILOT - 3 nabori na RTX 3060. Tu se koda razvija in preverja.
'    Zanka učenja je v src/runner.py in je ISTA kot na Arnesu.
' ---------------------------------------------------------------------------
@startuml 02_lokalni_pilot
title 2. Lokalni pilot: python -m src.run_benchmark ~--dataset-set subset

skinparam sequenceMessageAlign center
autonumber

actor "Uporabnik" as U
participant "src/run_benchmark.py" as BENCH
participant "src/config.py" as CFGPY
participant "src/runner.py" as RUN
participant "src/data.py" as DATA
database "OpenML\n(predpomnilnik)" as OML
participant "src/models/~__init~__.py\n(REGISTRY)" as REG
participant "src/models/<algoritem>.py" as MODEL
participant "src/utils.py" as UTILS
collections "results/runs/<run_id>/\nmanifest.json, per_dataset/,\npredictions/, results.csv" as OUT

U -> BENCH : python -m src.run_benchmark [~--dataset-set subset] [~--run-id X]
activate BENCH

BENCH -> CFGPY : load_config(), dataset_specs(config, set)
CFGPY --> BENCH : config (seme, foldi, algoritmi, poti), opisi naborov
BENCH -> RUN : make_run_id() -> <datum-čas>_<nabor>_<stroj>, run_dir_for()
BENCH -> RUN : write_manifest(run_dir, config, ...)
RUN -> OUT : manifest.json - git commit, stroj, GPU, konfiguracija, pip freeze,\nmodel_checkpoints (uteži temeljnih modelov); zapis prek .tmp, edinstvenega za proces

loop za vsak nabor iz izbranega nabora (3)
    BENCH -> RUN : run_dataset(spec, config, run_dir, run_id)
    activate RUN
    alt per_dataset/<id>.csv že obstaja
        RUN --> BENCH : "already done"
    else
        opt obstaja <id>.csv.partial
            RUN -> OUT : prebere partial -> množica done (algoritem, fold)
        end
        RUN -> DATA : load_dataset(spec, n_splits, random_state, cache_dir, n_repeats)
        activate DATA
        alt OpenML
            DATA -> OML : openml.datasets.get_dataset(id)
            OML --> DATA : surovi nabor + categorical_indicator
        else CSV (npr. medic3)
            DATA -> DATA : pd.read_csv(path), target, drop_cols
        end
        DATA -> DATA : X.reset_index(drop=True)
        DATA -> DATA : LabelEncoder na y ("good"/"bad" -> 0/1)
        DATA -> DATA : (Repeated)StratifiedKFold(seed) - **list(split())**\nfolde izračuna ENKRAT za vse algoritme
        DATA --> RUN : {name, source, X, y, classes, categorical_cols, folds}
        deactivate DATA

        loop za vsak algoritem iz config.yaml (6)
            RUN -> REG : REGISTRY[ime] -> modul
            opt modul.USES_GPU in še ni ogret v tem procesu
                RUN -> MODEL : warmup: run() na 64x4 sintetičnem naboru
                note right: nalaganje utež + CUDA init\nne obremeni folda 0 (warmup_s)
            end
            loop za vsak fold (n_splits x n_repeats)
                RUN -> RUN : preskoči, če (algoritem, fold) v done
                RUN -> MODEL : run(X_train, y_train, X_test, y_test, categorical_cols, random_state + repeat)
                activate MODEL
                MODEL -> MODEL : predobdelava po pravilu tega algoritma
                MODEL -> MODEL : t0 = perf_counter(); clf.fit(...)
                MODEL -> MODEL : t0 = perf_counter(); clf.predict_proba(...)
                MODEL -> UTILS : compute_roc_auc(y_test, proba), describe_device()
                UTILS --> MODEL : ROC-AUC (binarno ali OvR macro), 'cpu x8' / 'cuda: ...'
                MODEL --> RUN : {roc_auc, train_time_s, inference_time_s,\nerror, preprocessing, raw_error, device, proba}
                deactivate MODEL
                RUN -> OUT : predictions/<id>/<algoritem>_r<rep>_f<fold>.npz (proba, y_test, test_idx)
                RUN -> OUT : vrstica (RESULT_COLUMNS) + **write_partial()** atomarno
            end
        end
        RUN -> OUT : **os.replace(partial -> per_dataset/<id>.csv)**
    end
    deactivate RUN
end

BENCH -> RUN : merge_run(run_dir)
RUN -> OUT : results.csv (3 x 6 x 15 = 270 vrstic)
BENCH --> U : "Povzetek: python -m src.summary <run_dir>"
deactivate BENCH

note over MODEL
  Šest modulov z **identičnim podpisom** run(..., random_state):
  src/models/random_forest.py   - nativni NaN, kategorične -> kode
  src/models/xgboost_model.py   - nativni NaN + 'category' dtype
  src/models/lightgbm_model.py  - nativni NaN + 'category' dtype
  src/models/catboost_model.py  - nativni NaN + cat_features
  src/models/tabpfn_model.py    - SUROVO, fallback šele ob napaki (USES_GPU);
                                  TabPFN-3.5 izrecno prek make_classifier()
  src/models/tabicl_model.py    - SUROVO, fallback šele ob napaki (USES_GPU)
  src/models/xgboost_tuned.py   - poskus uglaševanja: mreža 128 nastavitev,
                                  gnezdeno PP na učnem delu; le z ~--algorithms

  Vsi so oviti v try/except: izjema se zapiše v
  result["error"] in se NE dvigne naprej (fail-soft),
  zato en neuspeh ne sesuje celotnega zagona.
  Vsaka vrstica rezultata nosi preprocessing, raw_error,
  device, git_commit, hostname, timestamp - dnevnik
  predobdelave je torej del CSV-ja vsakega zagona.

  src/~__init~__.py je prazen - obstaja le zato,
  da je src/ paket in delujejo uvozi "from src...".
end note

@enduml


' ---------------------------------------------------------------------------
' 3. ARNES HPC - vseh 72 naborov. Prijavno vozlišče ima internet, računska ne.
' ---------------------------------------------------------------------------
@startuml 03_arnes
title 3. Zagon na gruči Arnes (72 naborov, SLURM array)

skinparam sequenceMessageAlign center
autonumber

actor "Uporabnik" as U
box "Prijavno vozlišče (internet, brez GPU)" #FDF6E3
    participant "scripts/prestage.py" as PRE
end box
participant "SLURM\n(čakalna vrsta)" as SLURM
box "Računsko vozlišče (H100, BREZ interneta)" #EEF6FD
    participant "scripts/run_cc18.sh" as SH
    participant "scripts/run_medic3.sh" as SHM
    participant "scripts/run_tuning.sh" as SHT
    participant "scripts/run_leakage.sh" as SHL
    participant "scripts/run_leakage_cpu.sh" as SHLC
    participant "src/run_one_dataset.py" as ONE
    participant "src/config.py" as CFGPY
    participant "src/runner.py" as RUN
end box
collections "results/runs/<RUN_ID>/per_dataset/\n<id>.csv, <id>.csv.partial" as PD
participant "scripts/merge_results.py" as MERGE
collections "results/runs/<RUN_ID>/results.csv" as FINAL

== Korak 1: predpriprava (samo prijavno vozlišče) ==

U -> PRE : python scripts/prestage.py ~--dataset-set cc18
activate PRE
PRE -> CFGPY : load_config(), dataset_specs(config, "cc18")
loop za vsak od 72 naborov
    PRE -> PRE : load_dataset(spec, ...) iz src/data.py - ista pot predpomnilnika kot benchmark
end
opt brez ~--skip-weights
    PRE -> PRE : tabpfn_model.make_classifier() (TabPFN-3.5) + TabICL.fit(device="cpu")\nna 40x5 naključnem naboru -> prenos natanko tistih utež, ki jih uporabi benchmark
end
PRE --> U : velikost predpomnilnika (kvota doma = 100 GB)\nizhodna koda 1, če kateri nabor manjka
deactivate PRE

note right of PRE
  Računska vozlišča imajo HF_HUB_OFFLINE=1,
  torej ne morejo prenesti ničesar. Vse -
  nabori IN uteži modelov - mora biti tu vnaprej.

  Zastavice: ~--dataset-set <ime> | ~--ids 31 37 (prevlada)
  in ~--skip-weights (samo nabori, brez utež).
end note

== Korak 2: oddaja polja (array job) ==

U -> SLURM : ALLOW_SPARSE_ARRAY=1 RUN_ID=cc18_v3 sbatch ~--array=... scripts/run_cc18.sh\n(dve polji z istim RUN_ID, glej opombo)
note right of SLURM
  ~#SBATCH ~--array=0-71%4  (privzeto: 72 nalog, največ 4 hkrati)
  Oddaja v DVEH poljih z istim RUN_ID: 0-26,28-59,62-69,71%4
  s privzetimi viri in 27,60,61,70 (mnist_784, Devnagari-Script,
  CIFAR_10, Fashion-MNIST) z ~--mem=240G ~--time=2-00:00:00.
  ~#SBATCH ~--gres=gpu:1 ~--cpus-per-task=8
  ~#SBATCH ~--mem=64G ~--time=12:00:00

  RUN_ID določa mapo results/runs/<RUN_ID>/. Ponovna
  oddaja z ISTIM RUN_ID nadaljuje iz partialov; nov
  RUN_ID = nov zagon od začetka (stari se ne prepiše).

  scripts/run_subset.sh je ista pot, le manjša
  (~--array=0-2, nabor subset) - validacijski zagon,
  s katerim se preveri, da gruča vrne enake številke
  kot lokalni računalnik (scripts/compare_results.py).
end note

== Korak 2b: Medic3 - polje po ALGORITMIH, ne po naborih ==

U -> SLURM : ALLOW_SPARSE_ARRAY=1 RUN_ID=medic3_raw sbatch\n~--array=0,1,2 ~--time=1-00:00:00 scripts/run_medic3.sh
U -> SLURM : ... sbatch ~--array=4,5 ~--mem=160G ~--time=1-00:00:00\nscripts/run_medic3.sh (TabICL odloži ~69 GB v RAM)
U -> SLURM : ... sbatch ~--array=3 ~--time=3-00:00:00 scripts/run_medic3.sh\n(CatBoost; pri medic3_160 ~--time=2-00:00:00)
activate SHM
SHM -> CFGPY : N_ALGOS = len(load_config()["algorithms"])\nALGO = algorithms[$SLURM_ARRAY_TASK_ID]
SHM -> ONE : python -m src.run_one_dataset ~--dataset-set $DATASET_SET\n~--index 0 ~--run-id $RUN_ID ~--algorithms $ALGO
ONE -> RUN : run_dataset(spec, ..., algorithms=[ALGO])
RUN -> PD : piše v <nabor>~__<algoritem>.csv (ne <id>.csv)
deactivate SHM

note over SHM
  Medic3 je EN nabor, zato bi shema "en nabor na task"
  vseh šest algoritmov gnala zaporedno (ocena ~60 h,
  čez ~--time). Tu je zato en ALGORITEM na task; indeks
  je mesto algoritma v config.yaml (algorithms):
  0 random_forest 1 xgboost 2 lightgbm 3 catboost
  4 tabpfn 5 tabicl. CatBoost gre v svoje opravilo,
  ker je pri 220 razredih daleč najdražji.

  Zato src/runner.py ob izrecnem ~--algorithms piše v
  <nabor>~__<algoritem>.csv: brez tega bi vzporedni
  taski istega nabora pisali isti .partial in si med
  sabo brisali vrstice. merge_results.py jih združi.

  DATASET_SET=medic3 (220 razredov; TabPFN-3.5 ima
  kot TabPFN-3 mejo 160 in tu mehko odpove) ali
  medic3_160 (160 najpogostejših razredov, steče vseh šest).
end note

loop 72 vzporednih nalog, $SLURM_ARRAY_TASK_ID = 0..71
    SLURM -> SH : zažene skripto z dodeljenim GPU
    activate SH
    SH -> SH : source ~/.tabpfn_token\nexport HF_HUB_OFFLINE=1, OMP_NUM_THREADS=8
    SH -> CFGPY : N_IDS = len(dataset_specs(config, "cc18"))
    SH -> SH : varovalka: SLURM_ARRAY_TASK_MAX == N_IDS-1 ?\nsicer **exit 1** (sicer bi zadnji nabori tiho izpadli)
    SH -> ONE : micromamba run -p ~/envs/tabular3.5 python -m src.run_one_dataset\n~--dataset-set cc18 ~--index $ID ~--run-id $RUN_ID
    activate ONE
    ONE -> CFGPY : load_config(), dataset_specs(config, "cc18")[index]
    ONE -> RUN : write_manifest() (le prvi task, ki pride do tu)
    ONE -> RUN : run_dataset(spec, config, run_dir, run_id)
    activate RUN
    alt <id>.csv že obstaja
        RUN --> ONE : "already done" (nabor je res dokončan)
    else nadaljevanje ali nov zagon
        RUN -> PD : prebere partial (če obstaja) -> done
        RUN -> RUN : ista zanka kot v diagramu 2:\nload_dataset -> warmup -> run() za vsak (algoritem, fold)
        RUN -> PD : **write_partial()** po VSAKEM učenju (.tmp + os.replace)
        RUN -> PD : **os.replace(partial -> <id>.csv)**\natomarno, šele ko so vse vrstice zbrane
    end
    deactivate RUN
    deactivate ONE
    deactivate SH
end

note over PD
  Dve ravni odpornosti na prekinitev:
  1. cel nabor: obstoj <id>.csv pomeni "already done"
  2. posamezno učenje: partial pove, kje nadaljevati

  Ker <id>.csv nastane samo z atomarnim os.replace()
  na koncu, se nepopoln rezultat NIKOLI ne more
  pretvarjati, da je popoln.
end note

== Korak 2c: poskus uglaševanja XGBoost (le CPU) ==

U -> SLURM : RUN_ID=cc18_xgb_tuned sbatch ~--array=0-35%8\nscripts/run_tuning.sh (36 nenasičenih; kasneje 36-67)
activate SHT
SHT -> ONE : python -m src.run_one_dataset ~--dataset-set cc18_tuning\n~--index $SLURM_ARRAY_TASK_ID ~--algorithms xgboost_tuned
ONE -> RUN : run_dataset(spec, ..., algorithms=["xgboost_tuned"])
RUN -> PD : <id>~__xgboost_tuned.csv (+ stolpec hyperparameters)\nin tuning/<id>/*.csv (vseh 128 nastavitev na fold)
deactivate SHT

== Korak 2d: test uhajanja podatkov ==

U -> SLURM : RUN_ID=cc18_leakage sbatch ~--array=0-33 scripts/run_leakage.sh
activate SHL
loop tri različice istega nabora zaporedoma na ISTEM vozlišču
    SHL -> ONE : python -m src.run_one_dataset ~--dataset-set cc18_leakage\n~--index 3*task+različica ~--algorithms catboost tabpfn tabicl
    ONE -> RUN : run_dataset(spec s ključi perturbation, repeats)
    RUN -> PD : <id>_<različica>~__catboost-tabpfn-tabicl.csv\n(foldi 0-4, + stolpec perturbation)
end
deactivate SHL
U -> SLURM : DATASET_SET=medic3_160_leakage ... sbatch ~--array=0 ~--mem=160G\nscripts/run_leakage.sh (TabPFN, TabICL)
U -> SLURM : DATASET_SET=medic3_160_leakage ... sbatch ~--array=0-2\nscripts/run_leakage_cpu.sh (CatBoost, brez GPU)
activate SHLC
SHLC -> ONE : ~--index $SLURM_ARRAY_TASK_ID ~--algorithms catboost\n(ena različica na task, privzeta CPU particija)
deactivate SHLC

== Korak 3: združevanje ==

U -> MERGE : python scripts/merge_results.py cc18_v2
activate MERGE
MERGE -> RUN : merge_run(run_dir)
RUN -> PD : *.csv - *.partial po definiciji ne ustreza
PD --> RUN : 72 dokončanih datotek
opt obstajajo *.partial
    RUN --> U : **OPOZORILO**: našteje nedokončane nabore\nin koliko učenj imajo
end
RUN -> FINAL : pd.concat -> results.csv
MERGE --> U : št. vrstic, št. naborov, št. vrstic z napako
deactivate MERGE

note over FINAL
  Pričakovano: 72 x 6 x n_splits x n_repeats vrstic.
  Manj vrstic = "nedokončano", nikoli "neuspelo" -
  neuspelo učenje vseeno zapiše svojo vrstico,
  s praznim roc_auc in razlogom v stolpcu error.

  Kurirani zagon se commita skupaj z manifest.json
  in results.csv; predictions/ ostanejo izven gita.
end note

@enduml


' ---------------------------------------------------------------------------
' 4. ANALIZA rezultatov in stranska veja (Medic3).
' ---------------------------------------------------------------------------
@startuml 04_analiza
title 4. Analiza rezultatov in stranska veja Medic3

skinparam sequenceMessageAlign center
autonumber

actor "Uporabnik" as U
participant "src/summary.py" as SUM
participant "src/stats.py" as STAT
participant "scripts/gen_version_table.py" as VER
participant "scripts/compare_results.py" as CMP
participant "scripts/profile_medic3.py" as MED
participant "scripts/diagnose_lightgbm_medic3.py" as DIAG
participant "scripts/audit_defaults.py" as AUD
participant "scripts/combine_runs.py" as COMB
participant "scripts/compute_metrics.py" as MET
participant "src/metrics.py" as METF
participant "scripts/analyze_leakage.py" as LEAK
collections "results/runs/<run_id>/\nresults.csv, manifest.json" as RES
collections "results/runs/<run_id>/summary/\n*.csv, *.tex, cd_diagram.png" as SUMOUT
collections "data/medic3/Medic3.csv\n(zaupno, NI v gitu)" as M3

== Povzetek za diplomo ==

U -> SUM : python -m src.summary <run_id>
activate SUM
SUM --> U : izpiše "Vir: <pot>" - da tabela nikoli ni dvoumna
SUM -> RES : pd.read_csv(results.csv)
SUM -> SUM : per_dataset_table: mean/std ROC-AUC, mediane časov;\ndelen neuspeh -> NaN
SUM -> SUM : dataset_pivot (nabor x algoritem), rank_matrix:\nrang NA NABOR, neuspeh = najslabši rang
SUM -> SUM : saturated_mask: najboljši >= saturation_threshold
SUM -> SUM : overall_table: povprečje na naborih, kjer so uspeli VSI;\nposebej še brez nasičenih naborov
SUM -> SUMOUT : overall, overall_nonsaturated, per_dataset,\npivot, ranks (.csv + .tex)
SUM --> U : tabele + seznam neuspelih učenj
deactivate SUM

== Delni ponovni zagon: sestavljen nabor rezultatov ==
U -> COMB : python scripts/combine_runs.py cc18_v4 ~--base cc18_v3
activate COMB
COMB -> RES : bere oba results.csv in manifest.json
COMB -> COMB : preveri enake nastavitve delitev, nabore\nin velikosti foldov
COMB -> RES : <nov>/combined/results.csv (nov zagon + manjkajoči\nalgoritmi iz starega) in sources.json
deactivate COMB
note right of COMB
  Po popravku "kot iz škatle" (2026-10-14) sta ponovno
  tekla le RandomForest in XGBoost; summary in stats
  nato tečeta na combined/results.csv.
end note

== Dodatni metriki iz shranjenih napovedi (brez ponovnega učenja) ==
U -> MET : python scripts/compute_metrics.py <run_id ali combined>
activate MET
MET -> RES : results.csv; za vsako uspelo učenje
predictions/<nabor>/<algo>_r<r>_f<f>.npz
(pri combined/ iz zagona v stolpcu run_id)
MET -> METF : compute_accuracy, compute_log_loss
(float32 -> float64, vrstica normirana na 1)
MET -> MET : kontrola: ROC-AUC iz datoteke proti results.csv
(float32 -> razlika do ~1e-3), manjkajoče datoteke -> izhodna koda 1
MET -> RES : metrics.csv, metrics_info.json (ob results.csv)
deactivate MET
U -> SUM : python -m src.summary <run> ~--metric accuracy | log_loss
SUM -> METF : HIGHER_IS_BETTER (pri log_loss rang 1 = najnižja)
SUM -> SUMOUT : summary/<metrika>/ (nasičenost vedno po ROC-AUC)
note right of MET
  src/metrics.py namenoma ni na učni poti (modeli in
  runner ga ne uvozijo), da se koda, ki uči, z dodanimi
  metrikami ne spremeni. src.stats ~--metric enako.
end note

== Statistična značilnost (Demšar 2006) ==

U -> STAT : python -m src.stats <run_id> [~--no-saturated] [~--metric M]
activate STAT
alt več naborov (CC18)
    STAT -> SUM : dataset_pivot, rank_matrix (isto pravilo za neuspeh)
    STAT -> STAT : Friedmanov test: chi2_F po Demšarjevi formuli iz povprečnih rangov\n+ Iman-Davenportova F_F (odloča o zavrnitvi)
    STAT -> STAT : Nemenyi: CD = q_alpha * sqrt(k(k+1)/6N)
    STAT -> STAT : parni Wilcoxon na povprečnem ROC-AUC + holm()
    STAT -> SUMOUT : cd_diagram.png/.pdf, friedman.csv,\nnemenyi.csv, wilcoxon_holm.csv/.tex
    STAT --> U : chi2_F, F_F, p, CD, povprečni rangi, značilni pari
else en sam nabor (Medic3) - zazna samodejno
    STAT -> STAT : za vsak par: popravljeni t-test za ponovljeno k-kratno\nprečno preverjanje (Bouckaert in Frank 2004) na istih foldih + holm()
    STAT -> SUMOUT : corrected_ttest_holm.csv/.tex
    STAT --> U : t, p, p_holm po parih; izključeni algoritmi z neuspehom
end
deactivate STAT

